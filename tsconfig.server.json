{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "noEmit": false,
    "target": "ES2020",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/server.ts",
    "src/modules/realtime/socket.ts",
    "src/modules/realtime/events.ts",
    "src/modules/jobs/worker.ts"
  ],
  "exclude": ["node_modules"]
}
