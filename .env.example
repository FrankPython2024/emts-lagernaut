DATABASE_URL=mysql://USER:PASSWORD@db:3306/lagernaut
REDIS_URL=redis://redis:6379
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_KEY=YOUR_MEILISEARCH_MASTER_KEY
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET
NEXTAUTH_URL=http://YOUR_SERVER_IP:3000

# Eigenes Passwort für den read-only Datenbank-Explorer (/admin/datenbank, nur Rolle ADMIN).
# MUSS auf dem VPS gesetzt werden — ohne diese Variable bleibt der Explorer dauerhaft gesperrt.
DB_EXPLORER_PASSWORD=YOUR_DB_EXPLORER_PASSWORD
