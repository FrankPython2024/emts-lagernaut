generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  kuerzel         String    @unique
  email           String    @unique
  password        String
  rolle           UserRolle @default(TECHNIKER)
  aktiv           Boolean   @default(true)
  lastLogin       DateTime?
  // Dashboard-Konfiguration pro User: { layouts, visibility } | null = Default
  dashboardConfig Json?
  standortId      Int?
  standort        Standort? @relation(fields: [standortId], references: [id])
  // Wildcard: true = Zugriff auf alle Standorte (gesetzt für ADMIN-User per Migration).
  // Bei false: Zugriff via standortId (Haupt) + UserStandortAccess (zusätzliche).
  alleStandorte   Boolean   @default(false)
  standortAccess  UserStandortAccess[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([standortId])
}

// Zusätzliche Standorte pro User (M:N). Hauptstandort steckt in User.standortId.
model UserStandortAccess {
  id         Int      @id @default(autoincrement())
  userId     Int
  standortId Int
  erstelltAm DateTime @default(now())

  user     User     @relation(fields: [userId],     references: [id], onDelete: Cascade)
  standort Standort @relation(fields: [standortId], references: [id], onDelete: Cascade)

  @@unique([userId, standortId])
  @@index([userId])
  @@index([standortId])
}

enum UserRolle {
  ADMIN
  TECHNIKER
  BETRACHTER
}

// ── RBAC (Phase 1+2 — Fundament, noch keine User-Verknüpfung) ────────────────

model Rolle {
  id           Int               @id @default(autoincrement())
  name         String            @unique @db.VarChar(50)
  bezeichnung  String            @db.VarChar(100)
  beschreibung String?           @db.VarChar(255)
  istSystem    Boolean           @default(false)
  aktiv        Boolean           @default(true)
  erstelltAm   DateTime          @default(now())
  permissions  RollePermission[]

  @@index([aktiv])
}

model Permission {
  id           Int               @id @default(autoincrement())
  key          String            @unique @db.VarChar(50)
  bezeichnung  String            @db.VarChar(100)
  kategorie    String            @db.VarChar(50)
  beschreibung String?           @db.VarChar(255)
  rollen       RollePermission[]

  @@index([kategorie])
}

model RollePermission {
  id           Int @id @default(autoincrement())
  rolleId      Int
  permissionId Int

  rolle      Rolle      @relation(fields: [rolleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([rolleId, permissionId])
  @@index([rolleId])
  @@index([permissionId])
}

// ── Multi-Standort ────────────────────────────────────────────────────────────

model Standort {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(100)
  kurzname     String       @unique @db.VarChar(10)
  adresse      String?      @db.VarChar(500)
  aktiv        Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  lagerplaetze Lagerplatz[]
  users        User[]
  artikel      Artikel[]
  userAccess   UserStandortAccess[]
}

model Artikel {
  id          Int               @id @default(autoincrement())
  bezeichnung String            @db.VarChar(255) // TODO: 47 Drift-Artikel mit Marketing-Text bereinigen
  lagerplatz  String?
  kategorie   String
  bestand     Int               @default(0)
  buchungen   Buchung[]
  anfragen    Anfrage[]
  kompatibel  Kompatibilitaet[]
  korbItems   WarenkorbItem[]
  standortId  Int               @default(1)
  standort    Standort          @relation(fields: [standortId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([bezeichnung, kategorie, standortId])
  @@index([standortId])
}

model Buchung {
  id          Int         @id @default(autoincrement())
  datum       DateTime    @default(now())
  mitarbeiter String
  artikelId   Int
  bezeichnung String
  typ         BuchungsTyp
  menge       Int
  notiz       String?
  artikel     Artikel     @relation(fields: [artikelId], references: [id])
  createdAt   DateTime    @default(now())

  @@index([artikelId])
  @@index([typ])
  @@index([datum])
}

enum BuchungsTyp {
  EINGANG
  AUSGANG
  DIREKT
}

model Anfrage {
  id               Int           @id @default(autoincrement())
  datum            DateTime      @default(now())
  techniker        String
  logId            String
  geraeteName      String?
  geraet           String
  artikelId        Int?
  teil             String
  menge            Int           @default(1)
  grading          String?
  kommentar        String?
  gruppenNr        String?
  korbId           Int?
  korb             Warenkorb?    @relation(fields: [korbId], references: [id], onDelete: SetNull)
  istSonderAnfrage Boolean       @default(false)
  beschreibung     String?       @db.Text
  sonderKategorie  String?
  status           AnfrageStatus @default(NEU)
  bearbeitetVon    String?
  bearbeitetSeit   DateTime?
  artikel          Artikel?      @relation(fields: [artikelId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([techniker])
  @@index([status])
  @@index([logId])
  @@index([artikelId])
  @@index([gruppenNr])
  @@index([bearbeitetVon, status])
}

enum AnfrageStatus {
  NEU
  BEDARF
  IN_BEARBEITUNG
  ABGESCHLOSSEN
  STORNIERT
}

model Kompatibilitaet {
  id        Int     @id @default(autoincrement())
  geraet    String
  teiltyp   String
  artikelId Int
  artikel   Artikel @relation(fields: [artikelId], references: [id])

  @@unique([geraet, teiltyp])
}

model GeraeteModell {
  id               Int             @id @default(autoincrement())
  hersteller       String
  modell           String          @db.VarChar(500)
  aktiv            Boolean         @default(true)
  deaktiviertGrund String?         @db.VarChar(191)
  deaktiviertAm    DateTime?
  createdAt        DateTime        @default(now())
  belegung         LagerplatzBelegung?
  modellTeiltypen  ModellTeiltyp[]

  @@unique([hersteller, modell])
  @@index([aktiv])
}

model Lagerplatz {
  id         Int            @id @default(autoincrement())
  code       String         @unique // "ETL-1-6-5"
  regal      Int // logische Regal-Nr
  reihe      Int // physische Reihen-Nr (für Anzeige)
  ebene      Int
  fach       Int
  hersteller String? // "HP" | "Lenovo" | "Dell" | null — Region-Hinweis des Fachs
  belegungen LagerplatzBelegung[]
  standortId Int            @default(1)
  standort   Standort       @relation(fields: [standortId], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([hersteller])
  @@index([reihe, ebene, fach])
  @@index([standortId])
  @@map("lagerplatz")
}

// Mehrere Modelle pro Fach (max 4), alle gleicher Hersteller.
// modellId @unique = 1 Modell lebt in genau EINEM Fach; N Modelle pro Fach erlaubt.
model LagerplatzBelegung {
  id           Int           @id @default(autoincrement())
  lagerplatzId Int
  modellId     Int           @unique
  erstelltAm   DateTime      @default(now())
  lagerplatz   Lagerplatz    @relation(fields: [lagerplatzId], references: [id], onDelete: Cascade)
  modell       GeraeteModell @relation(fields: [modellId], references: [id], onDelete: Cascade)

  @@index([lagerplatzId])
}

model Teiltyp {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  icon            String? // Lucide-Icon-Name (z.B. "Wifi", "Battery")
  istStandard     Boolean         @default(false)
  sortierung      Int             @default(0)
  aktiv           Boolean         @default(true)
  erstelltAm      DateTime        @default(now())
  modellTeiltypen ModellTeiltyp[]

  @@index([aktiv, sortierung])
}

model ModellTeiltyp {
  id         Int      @id @default(autoincrement())
  modellId   Int
  teiltypId  Int
  erstelltAm DateTime @default(now())

  modell  GeraeteModell @relation(fields: [modellId], references: [id], onDelete: Cascade)
  teiltyp Teiltyp       @relation(fields: [teiltypId], references: [id], onDelete: Cascade)

  @@unique([modellId, teiltypId])
  @@index([modellId])
  @@index([teiltypId])
}

model GeraeteLookup {
  id          Int      @id @default(autoincrement())
  logId       String   @unique
  logIdClean  String
  bezeichnung String   @db.Text // TEXT: Marketing-Beschreibungen bis 514+ Zeichen
  bereinigt   String   @db.Text // TEXT: bereinigter Modellname bis 502+ Zeichen
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([logId])
  @@index([logIdClean])
}

model Warenkorb {
  id          Int             @id @default(autoincrement())
  techniker   String
  logId       String
  geraeteName String?
  status      KorbStatus      @default(AKTIV)
  items       WarenkorbItem[]
  anfragen    Anfrage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([techniker, logId, status])
}

enum KorbStatus {
  AKTIV
  ABGESENDET
}

model WarenkorbItem {
  id               Int       @id @default(autoincrement())
  korbId           Int
  artikelId        Int?
  teiltyp          String?
  grading          String?
  zusatzinfo       String?
  istSonderAnfrage Boolean   @default(false)
  beschreibung     String?   @db.Text
  sonderKategorie  String?
  korb             Warenkorb @relation(fields: [korbId], references: [id])
  artikel          Artikel?  @relation(fields: [artikelId], references: [id])
}

model TechnikerSession {
  id       Int      @id @default(autoincrement())
  kuerzel  String   @unique
  lastSeen DateTime @default(now())
  online   Boolean  @default(false)
}

model LagerplatzConfig {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  beschreibung String?
  bereich      String?
  createdAt    DateTime @default(now())
}

// ── Stresstest-Historie ───────────────────────────────────────────────────────

model StressTestRun {
  id            Int      @id @default(autoincrement())
  startedAt     DateTime
  endedAt       DateTime
  modus         String
  technikerAnz  Int
  adminAnz      Int
  score         Int
  totalOps      Int
  fehler        Int
  avgResponseMs Int
  p95Ms         Int
  report        Json
  createdAt     DateTime @default(now())
}

// ── Nachrichten ──────────────────────────────────────────────────────────────
// Chat-Nachrichten nutzen logId = "chat:{anfrageId}" zur Zuordnung.

model Nachricht {
  id         Int                @id @default(autoincrement())
  betreff    String              @db.VarChar(255)
  inhalt     String             @db.Text
  vonKuerzel String
  typ        NachrichtTyp       @default(DIREKT)
  logId      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  empfaenger NachrichtEmpf[]
  antworten  NachrichtAntwort[]

  @@index([vonKuerzel])
  @@index([createdAt])
  @@index([logId])
}

model NachrichtEmpf {
  id          Int       @id @default(autoincrement())
  nachrichtId Int
  empfKuerzel String
  gelesen     Boolean   @default(false)
  gelesenAt   DateTime?
  nachricht   Nachricht @relation(fields: [nachrichtId], references: [id], onDelete: Cascade)

  @@unique([nachrichtId, empfKuerzel])
  @@index([empfKuerzel])
  @@index([nachrichtId])
}

model NachrichtAntwort {
  id          Int       @id @default(autoincrement())
  nachrichtId Int
  vonKuerzel  String
  inhalt      String    @db.Text
  createdAt   DateTime  @default(now())
  nachricht   Nachricht @relation(fields: [nachrichtId], references: [id], onDelete: Cascade)

  @@index([nachrichtId])
}

enum NachrichtTyp {
  DIREKT
  BROADCAST
  SYSTEM
}
