generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  name                String
  kuerzel             String               @unique
  email               String               @unique
  password            String
  rolle               UserRolle            @default(TECHNIKER)
  aktiv               Boolean              @default(true)
  lastLogin           DateTime?
  // Dashboard-Konfiguration pro User: { layouts, visibility } | null = Default
  dashboardConfig     Json?
  standortId          Int?
  standort            Standort?            @relation(fields: [standortId], references: [id])
  // Wildcard: true = Zugriff auf alle Standorte (gesetzt für ADMIN-User per Migration).
  // Bei false: Zugriff via standortId (Haupt) + UserStandortAccess (zusätzliche).
  alleStandorte       Boolean              @default(false)
  standortAccess      UserStandortAccess[]
  externeBestellungen ExterneBestellung[]
  colliDruckLogs      ColliDruckLog[]
  pickupAuftraege     PickupAuftrag[]      @relation("PickupErsteller")
  pickupAbgeschlossen PickupAuftrag[]      @relation("PickupAbschliesser")
  pickupGefunden      PickupPosition[]
  extraPermissions    UserPermission[]
  permissionDenies    UserPermissionDeny[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([standortId])
}

// Zusätzliche Standorte pro User (M:N). Hauptstandort steckt in User.standortId.
model UserStandortAccess {
  id         Int      @id @default(autoincrement())
  userId     Int
  standortId Int
  erstelltAm DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  standort Standort @relation(fields: [standortId], references: [id], onDelete: Cascade)

  @@unique([userId, standortId])
  @@index([userId])
  @@index([standortId])
}

enum UserRolle {
  ADMIN
  TECHNIKER
  BETRACHTER
  ADMIN_READONLY // Audit-Sicht: voller Lesezugriff auf den Admin-Bereich, keine Schreibrechte
  PICKUP // Picker: arbeitet Pickup-Aufträge scannend ab (Recht PICKUP_PICK)
}

// ── RBAC (Phase 1+2 — Fundament, noch keine User-Verknüpfung) ────────────────

model Rolle {
  id           Int               @id @default(autoincrement())
  name         String            @unique @db.VarChar(50)
  bezeichnung  String            @db.VarChar(100)
  beschreibung String?           @db.VarChar(255)
  istSystem    Boolean           @default(false)
  aktiv        Boolean           @default(true)
  erstelltAm   DateTime          @default(now())
  permissions  RollePermission[]

  @@index([aktiv])
}

model Permission {
  id           Int               @id @default(autoincrement())
  key          String            @unique @db.VarChar(50)
  bezeichnung  String            @db.VarChar(100)
  kategorie    String            @db.VarChar(50)
  beschreibung String?           @db.VarChar(255)
  rollen       RollePermission[]
  users        UserPermission[]

  @@index([kategorie])
}

model RollePermission {
  id           Int @id @default(autoincrement())
  rolleId      Int
  permissionId Int

  rolle      Rolle      @relation(fields: [rolleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([rolleId, permissionId])
  @@index([rolleId])
  @@index([permissionId])
}

// Zusatz-Rechte pro User (zusätzlich zur Rolle). Effektive Rechte eines Users =
// Rollen-Rechte ∪ Zusatz-Rechte. Analog zu RollePermission, aber User↔Permission.
model UserPermission {
  id           Int      @id @default(autoincrement())
  userId       Int
  permissionId Int
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

// Entzogene Rechte pro Account (Deny-Ebene). Entzug gewinnt über Rollen-/Zusatz-
// rechte (siehe getMeinePermissions). Bewusst als String-Key (kein FK), damit der
// Entzug unabhängig von der Permission-Tabelle bestehen bleibt.
// AUSNAHME: SYSTEM_ADMIN ist NICHT entziehbar (Lockout-Sicherung) — wird in
// getMeinePermissions ignoriert.
model UserPermissionDeny {
  id         Int      @id @default(autoincrement())
  userId     Int
  permission String // Recht-Key, z. B. "ARTIKEL_EDIT"
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
}

// ── Multi-Standort ────────────────────────────────────────────────────────────

model Standort {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  kurzname  String   @unique @db.VarChar(10)
  adresse   String?  @db.VarChar(500)
  aktiv     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lagerplaetze Lagerplatz[]
  users        User[]
  artikel      Artikel[]
  userAccess   UserStandortAccess[]
}

model Artikel {
  id            Int               @id @default(autoincrement())
  bezeichnung   String            @db.VarChar(255) // TODO: 47 Drift-Artikel mit Marketing-Text bereinigen
  lagerplatz    String?
  kategorie     String
  bestand       Int               @default(0)
  buchungen     Buchung[]
  anfragen      Anfrage[]
  kompatibel    Kompatibilitaet[]
  korbItems     WarenkorbItem[]
  // Einzelpreis dieses Artikels. Schlägt den Kategoriepreis (KategoriePreis),
  // wenn gesetzt. Nötig für Artikel, bei denen die Kategorie nichts über den
  // Wert sagt: eine 256-GB-SSD und eine 2-TB-NVMe sind beide „Festplatte",
  // unterscheiden sich im Wert aber um ein Vielfaches.
  // null = wie bisher der Kategoriepreis.
  preis         Decimal?          @db.Decimal(10, 2)
  // ── Ersatzteil-Pool (aktuell nur für Gummifüße gedacht) ──────────────────
  // Zwei Artikel, die dasselbe physische Teil sind (z. B. beim U711 sind vordere
  // und hintere Füße baugleich), teilen sich rechnerisch EINEN Bestand: Ist der
  // eine leer und der andere voll, gilt die Anfrage trotzdem als lieferbar und
  // wird vom Partner abgebucht.
  //
  // Bewusst ein einfaches Int-Feld OHNE Fremdschlüssel: Die Verknüpfung ist
  // eine symmetrische Partnerschaft (A↔B, beide Seiten zeigen aufeinander) und
  // keine Besitz-Beziehung — als Prisma-Selbstrelation wäre das umständlicher
  // zu setzen und zu lösen. Der Code prüft die Gegenseite null-sicher.
  // Wird ein Artikel gelöscht, bleibt beim Partner eine tote Id zurück; das
  // fällt nicht auf, weil jede Abfrage den Partner ohnehin nachschlägt.
  poolPartnerId Int?
  // ── Teilenummer als Identitaet ──────────────────────────────────────────
  // Die vom Hersteller aufgedruckte bzw. aufgeklebte Nummer. Ist sie gesetzt,
  // ist SIE der Schluessel des Artikels, nicht die Bezeichnung: Dasselbe Teil
  // ueber die LogID eines Spendergeraets und lose eingelagert muss auf
  // denselben Artikel laufen, sonst entstehen wieder Dubletten.
  // null = wie bisher, Identitaet ueber (bezeichnung, kategorie, standortId).
  teilenummerId Int?
  teilenummer   Teilenummer?      @relation(fields: [teilenummerId], references: [id])
  standortId    Int               @default(1)
  standort      Standort          @relation(fields: [standortId], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([bezeichnung, kategorie, standortId])
  // Eine Teilenummer ergibt je Standort genau EINEN Artikel. NULL bleibt in
  // MySQL mehrfach erlaubt, Altbestand ohne Nummer stoert also nicht.
  @@unique([teilenummerId, standortId])
  @@index([standortId])
  @@index([poolPartnerId])
}

// ── Gerätefotos ───────────────────────────────────────────────────────────────
//
// Ein Foto je Gerätemodell, damit im Pickup sichtbar ist, wonach man sucht.
// Wer eine Reihe abarbeitet, erkennt ein Gerät am Bild schneller als an
// „HP EliteBook 840 G5" — gerade wer neu ist oder die Baureihen nicht kennt.
//
// ⚠️ Schlüssel ist der bereinigte MODELLNAME als Text, kein Fremdschlüssel auf
// GeraeteModell. Grund: Die Pickup-Positionen tragen nur einen Bezeichnungs-
// Text aus ReForm, und der lässt sich nicht immer sicher einem Katalogeintrag
// zuordnen. Über den Namen funktioniert es auch für Geräte, die (noch) gar
// nicht im Katalog stehen.
//
// Die Sammlung füllt sich von selbst: Wer ein Modell zum ersten Mal in der
// Hand hat, fotografiert es, alle danach sehen das Bild.
model GeraeteFoto {
  id             Int      @id @default(autoincrement())
  // Bereinigter Modellname MIT Hersteller-Präfix, z. B. „HP EliteBook 840 G5",
  // normalisiert auf Kleinschreibung ohne Sonderzeichen (siehe fotoSchluessel).
  schluessel     String   @db.VarChar(191)
  // Mehrere Bilder je Modell: Der AfB-Shop zeigt sieben Ansichten — vorn,
  // hinten, links, rechts und die Anschlussseite. Gerade letztere hilft beim
  // Wiedererkennen im Regal mehr als die Frontansicht.
  //
  // 0 = Titelbild. Ein selbst aufgenommenes Foto belegt immer die 0 und steht
  // damit vorn, egal wie viele Katalogbilder daneben liegen.
  position       Int      @default(0)
  /// Was das Bild zeigt, aus dem Dateinamen abgeleitet: front, ports, back …
  ansicht        String?  @db.VarChar(40)
  // Anzeigename, wie er beim Anlegen aussah — nur fürs Auge.
  anzeige        String   @db.VarChar(255)
  mimeType       String   @db.VarChar(50)
  daten          Bytes    @db.MediumBlob
  // SELBST = jemand hat das Gerät fotografiert. SHOP = aus dem AfB-Shop geholt.
  // Ein selbst aufgenommenes Bild darf NIE von einem Shop-Bild überschrieben
  // werden: Wer das Gerät in der Hand hatte, weiß es besser als der Katalog.
  quelle         String   @default("SELBST") @db.VarChar(20)
  erstelltVon    String?  @db.VarChar(100)
  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@unique([schluessel, position])
  @@index([schluessel])
}

// ── Teilenummern-Wissen ───────────────────────────────────────────────────────
//
// Eine Zeile je physisch aufgedruckter Nummer, standortuebergreifend. Das ist
// die Wissensbasis: Was ist das fuer ein Teil, von wem, und in welche Modelle
// passt es. Sie startet leer und fuellt sich beim Einlagern.
//
// ⚠️ Auch eine Nummer, ueber die noch NICHTS bekannt ist, hat schon Wert: Sie
// sagt „dieses Teil ist dasselbe wie jenes" und verhindert damit Dubletten.
model Teilenummer {
  id              Int     @id @default(autoincrement())
  nummer          String  @unique @db.VarChar(120)
  hersteller      String? @db.VarChar(100)
  teiltyp         String? @db.VarChar(100)
  // Seriennummern sind pro Stueck einmalig und taugen NICHT als Teilenummer.
  // Erkennungshilfe: eine Nummer, die nur ein einziges Mal vorkommt, ist
  // verdaechtig. Entschieden wird das auf der Pflegeseite, nicht an der Werkbank.
  istSeriennummer Boolean @default(false)
  // true = ein Mensch hat die Modellliste bestaetigt. Erst dann gilt sie als
  // gesichert im Sinne der Zusage, Kompatibilitaeten nur sicher zu pflegen.
  geprueft        Boolean @default(false)
  notiz           String? @db.VarChar(500)
  // Wie oft wurde diese Nummer bisher gescannt/erfasst — Grundlage fuer den
  // Seriennummern-Verdacht und fuer die Sortierung der Pflegeliste.
  sichtungen      Int     @default(0)

  // ── Vergleichsfoto ────────────────────────────────────────────────────
  // Das Bild, mit dem dieses Teil erkannt wurde. Zwei Zwecke:
  //
  //   1. Wiedererkennen. Wer dasselbe Teil in der Hand hat, vergleicht mit
  //      dem Bild statt mit einer Beschreibung. Bei Teilen, die sich nur in
  //      Nuancen unterscheiden, ist das oft mehr wert als jeder Text.
  //   2. Trainingsmaterial. Foto plus bestaetigter Teiltyp ist genau ein
  //      beschriftetes Beispiel. Ohne diese Sammlung kann ein eigenes,
  //      lokales Erkennungsmodell nie entstehen — und das ist der einzige
  //      Weg, dauerhaft ohne fremden Dienst auszukommen.
  //
  // Bewusst EIN Bild je Nummer, nicht je Stueck: Es geht um das Teil, nicht
  // um das Exemplar.
  fotoDaten      Bytes?    @db.MediumBlob
  fotoMime       String?   @db.VarChar(50)
  fotoAm         DateTime?
  erstelltAm     DateTime  @default(now())
  aktualisiertAm DateTime  @updatedAt

  artikel Artikel[]
  modelle TeilenummerModell[]

  @@index([geprueft])
  @@index([istSeriennummer])
}

// Welche Geraetemodelle passen zu dieser Nummer, und woher wissen wir das.
model TeilenummerModell {
  id            Int      @id @default(autoincrement())
  teilenummerId Int
  modellId      Int
  // SPENDER   = aus der LogID des Altgeraets, aus dem das Teil kam. Sicher.
  // MANUELL   = jemand hat es nachgeschlagen und eingetragen.
  // AUTOMATISCH = maschinell gefunden, noch nicht bestaetigt (Stufe 2).
  quelle        String   @default("SPENDER") @db.VarChar(20)
  bestaetigt    Boolean  @default(false)
  erstelltAm    DateTime @default(now())

  teilenummer Teilenummer   @relation(fields: [teilenummerId], references: [id], onDelete: Cascade)
  modell      GeraeteModell @relation(fields: [modellId], references: [id], onDelete: Cascade)

  @@unique([teilenummerId, modellId])
  @@index([modellId])
}

model Buchung {
  id              Int            @id @default(autoincrement())
  datum           DateTime       @default(now())
  mitarbeiter     String
  artikelId       Int
  bezeichnung     String
  typ             BuchungsTyp
  menge           Int
  notiz           String?
  // ── Bauteil-Ernte: Herkunft des eingelagerten Teils ────────────────────────
  // LogID des SPENDER-Altgeräts, aus dem dieses Teil ausgebaut wurde. Wird nur
  // beim Einlagern (EINGANG über den Einlager-Assistenten) gesetzt und nur, wenn
  // der Nutzer die LogID gescannt hat. Vorher wurde die gescannte LogID lediglich
  // ins Server-Log geschrieben und war danach verloren — damit war nicht
  // nachvollziehbar, aus welchem Gerät ein Ersatzteil stammt.
  // Grundlage für: Ernte-Auswertung (Teile je Gerät), Rückverfolgung bei
  // Reklamation und die Bewertung des gewonnenen Materialwerts.
  herkunftLogId   String?        @db.VarChar(100)
  // Woher stammt das eingelagerte Teil? Genau zwei Fälle:
  //   "SPENDER" = aus einem Altgerät ausgebaut (Bauteil-Ernte)
  //   "DRUCK"   = selbst hergestellt (3D-Drucker)
  // WICHTIG für die Auswertung: Nur SPENDER ist Gewinnung aus Altgeräten.
  // 3D-Druck läuft in großen Chargen (z. B. 280 Füße in EINER Buchung) und würde
  // die Ernte-Kennzahlen (Teile je Gerät, Materialwert) sonst massiv verfälschen.
  // NULL = Altdaten vor Einführung — dort sind beide Fälle nicht trennbar.
  herkunftArt     String?        @db.VarChar(20)
  // Abgabe an eine andere Niederlassung: gesetzt bei AUSGANG-Buchungen, die das
  // Material nicht an die eigene Technik, sondern an einen anderen Standort der
  // Gruppe geben (typisch Festplatten und Arbeitsspeicher). Grundlage für die
  // Auswertung „was ging wohin". null = normaler Vorgang im eigenen Haus.
  niederlassungId Int?
  niederlassung   Niederlassung? @relation(fields: [niederlassungId], references: [id])
  // ── Die andere Hälfte der Kette: WOHIN ist das Teil gegangen? ──────────────
  // `herkunftLogId` oben sagt, aus welchem Spendergerät ein Teil kam. Hier steht
  // die Anfrage, die diese Ausgabe ausgelöst hat — und über `Anfrage.logId` damit
  // das ZIELGERÄT, in das der Techniker das Teil eingebaut hat.
  //
  // Ohne diese Spalte war die Frage „in welchem Gerät steckt dieses Teil heute?"
  // nicht beantwortbar: Beide Enden waren gespeichert, die Verbindung dazwischen
  // nur als Freitext in `notiz` („Anfrage #123"). Gebraucht wird sie für
  // Rückruf-Selektion (welche Geräte haben ein Teil aus Spendergerät X) und für
  // den Nachweis der Ersatzteil-Herkunft je ausgeliefertem Gerät.
  //
  // Wird bei AUSGANG **und** DIREKT gesetzt — auch ein Pass-Through-Teil wird
  // physisch verbaut und gehört in die Kette; der Bestand bleibt davon unberührt.
  // null = Einlagerung, Abgabe an eine Niederlassung, oder Altdaten vor der
  // Einführung (für die greift das Nachtrag-Skript über die Notiz).
  //
  // onDelete: SetNull ist Absicht: Eine gelöschte Anfrage darf NIEMALS eine
  // Buchung mitnehmen — die Bestandshistorie ist die Grundlage von
  // `syncBestandAusHistorie()` und muss lückenlos bleiben.
  anfrageId       Int?
  anfrage         Anfrage?       @relation(fields: [anfrageId], references: [id], onDelete: SetNull)
  artikel         Artikel        @relation(fields: [artikelId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([artikelId])
  @@index([typ])
  @@index([datum])
  @@index([herkunftLogId])
  @@index([herkunftArt])
  @@index([niederlassungId])
  @@index([anfrageId])
}

// ── Niederlassungen (Empfänger von Material-Abgaben) ─────────────────────────
// Bewusst NICHT dasselbe wie `Standort`: Standorte sind Orte, an denen mit
// Lagernaut gearbeitet wird (eigene Lagerplätze, Nutzer, Artikel). Eine
// Niederlassung ist hier nur ein Empfänger — dorthin gehen z. B. Festplatten
// und Arbeitsspeicher, ohne dass dort jemand das System benutzt.
model Niederlassung {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(120)
  kurzname  String?   @db.VarChar(20)
  // Empfängeranschrift — erscheint auf dem Auslagerbeleg unter dem Namen und
  // macht daraus erst einen vollwertigen Lieferschein.
  adresse   String?   @db.VarChar(500)
  aktiv     Boolean   @default(true)
  notiz     String?   @db.VarChar(500)
  buchungen Buchung[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([aktiv])
}

enum BuchungsTyp {
  EINGANG
  AUSGANG
  DIREKT
}

model Anfrage {
  id               Int           @id @default(autoincrement())
  datum            DateTime      @default(now())
  techniker        String
  logId            String
  geraeteName      String?
  geraet           String
  artikelId        Int?
  teil             String
  menge            Int           @default(1)
  grading          String?
  kommentar        String?
  gruppenNr        String?
  korbId           Int?
  korb             Warenkorb?    @relation(fields: [korbId], references: [id], onDelete: SetNull)
  istSonderAnfrage Boolean       @default(false)
  beschreibung     String?       @db.Text
  sonderKategorie  String?
  // Manuell bewerteter Wert einer Sonderanfrage (Admin-Review). null = noch nicht
  // bewertet → in der Auswertung „Wert ausgegeben" gilt die Pauschale (5 €).
  sonderWert       Decimal?      @db.Decimal(10, 2)
  status           AnfrageStatus @default(NEU)
  bearbeitetVon    String?
  bearbeitetSeit   DateTime?
  // Test-Modus: Anfrage wurde von ADMIN / ADMIN_READONLY im Techniker-Portal-
  // Testmodus erstellt. Zählt NICHT in Statistik / KPIs / Bestell-Empfehlung und
  // darf beim Auslagern KEINEN echten Bestand verändern (Sicherheitsgurt analog
  // DIREKT). Bleibt in Admin-Liste + Activity-Log sichtbar (markiert).
  testModus        Boolean       @default(false)
  artikel          Artikel?      @relation(fields: [artikelId], references: [id])
  // Die Ausgabe-Buchungen zu dieser Anfrage. In aller Regel genau eine; eine
  // Liste, weil eine Anfrage aus dem Pool-Partner bedient oder nachträglich
  // korrigiert worden sein kann.
  buchungen        Buchung[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([techniker])
  @@index([status])
  @@index([logId])
  @@index([artikelId])
  @@index([gruppenNr])
  @@index([bearbeitetVon, status])
  @@index([testModus])
}

enum AnfrageStatus {
  NEU
  BEDARF
  IN_BEARBEITUNG
  ABGESCHLOSSEN
  STORNIERT
  NICHT_VERFUEGBAR
}

model Kompatibilitaet {
  id        Int     @id @default(autoincrement())
  geraet    String
  teiltyp   String
  artikelId Int
  artikel   Artikel @relation(fields: [artikelId], references: [id])

  // Multi-Artikel: pro (geraet, teiltyp) sind mehrere Artikel erlaubt (Pool).
  // Der unique-Key verhindert nur exakte Duplikate.
  @@unique([geraet, teiltyp, artikelId])
}

model GeraeteModell {
  id               Int                 @id @default(autoincrement())
  hersteller       String
  modell           String              @db.VarChar(500)
  aktiv            Boolean             @default(true)
  deaktiviertGrund String?             @db.VarChar(191)
  deaktiviertAm    DateTime?
  createdAt        DateTime            @default(now())
  belegung         LagerplatzBelegung?
  modellTeiltypen  ModellTeiltyp[]
  teilenummern     TeilenummerModell[]

  @@unique([hersteller, modell])
  @@index([aktiv])
}

model Lagerplatz {
  id         Int                  @id @default(autoincrement())
  code       String               @unique // "ETL-1-6-5"
  regal      Int // logische Regal-Nr
  reihe      Int // physische Reihen-Nr (für Anzeige)
  ebene      Int
  fach       Int
  hersteller String? // "HP" | "Lenovo" | "Dell" | null — Region-Hinweis des Fachs
  belegungen LagerplatzBelegung[]
  standortId Int                  @default(1)
  standort   Standort             @relation(fields: [standortId], references: [id])
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([hersteller])
  @@index([reihe, ebene, fach])
  @@index([standortId])
  @@map("lagerplatz")
}

// Mehrere Modelle pro Fach (max 4), alle gleicher Hersteller.
// modellId @unique = 1 Modell lebt in genau EINEM Fach; N Modelle pro Fach erlaubt.
model LagerplatzBelegung {
  id           Int           @id @default(autoincrement())
  lagerplatzId Int
  modellId     Int           @unique
  erstelltAm   DateTime      @default(now())
  lagerplatz   Lagerplatz    @relation(fields: [lagerplatzId], references: [id], onDelete: Cascade)
  modell       GeraeteModell @relation(fields: [modellId], references: [id], onDelete: Cascade)

  @@index([lagerplatzId])
}

model Teiltyp {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  icon            String? // Lucide-Icon-Name (z.B. "Wifi", "Battery")
  istStandard     Boolean         @default(false)
  sortierung      Int             @default(0)
  aktiv           Boolean         @default(true)
  erstelltAm      DateTime        @default(now())
  modellTeiltypen ModellTeiltyp[]

  @@index([aktiv, sortierung])
}

model ModellTeiltyp {
  id         Int      @id @default(autoincrement())
  modellId   Int
  teiltypId  Int
  erstelltAm DateTime @default(now())

  modell  GeraeteModell @relation(fields: [modellId], references: [id], onDelete: Cascade)
  teiltyp Teiltyp       @relation(fields: [teiltypId], references: [id], onDelete: Cascade)

  @@unique([modellId, teiltypId])
  @@index([modellId])
  @@index([teiltypId])
}

model GeraeteLookup {
  id          Int      @id @default(autoincrement())
  logId       String   @unique
  logIdClean  String
  bezeichnung String   @db.Text // TEXT: Marketing-Beschreibungen bis 514+ Zeichen
  bereinigt   String   @db.Text // TEXT: bereinigter Modellname bis 502+ Zeichen
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([logId])
  @@index([logIdClean])
}

model Warenkorb {
  id          Int             @id @default(autoincrement())
  techniker   String
  logId       String
  geraeteName String?
  status      KorbStatus      @default(AKTIV)
  items       WarenkorbItem[]
  anfragen    Anfrage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([techniker, logId, status])
}

enum KorbStatus {
  AKTIV
  ABGESENDET
}

model WarenkorbItem {
  id               Int       @id @default(autoincrement())
  korbId           Int
  artikelId        Int?
  teiltyp          String?
  // Stückzahl — nur bei den Gummifüßen > 1 möglich (max 2 vorne / 2 hinten),
  // siehe TEILTYPEN_MIT_MENGE. Wird beim Absenden in Anfrage.menge übernommen.
  menge            Int       @default(1)
  grading          String?
  zusatzinfo       String?
  istSonderAnfrage Boolean   @default(false)
  beschreibung     String?   @db.Text
  sonderKategorie  String?
  korb             Warenkorb @relation(fields: [korbId], references: [id])
  artikel          Artikel?  @relation(fields: [artikelId], references: [id])
}

model TechnikerSession {
  id       Int      @id @default(autoincrement())
  kuerzel  String   @unique
  lastSeen DateTime @default(now())
  online   Boolean  @default(false)
}

model LagerplatzConfig {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  beschreibung String?
  bereich      String?
  createdAt    DateTime @default(now())
}

// ── Stresstest-Historie ───────────────────────────────────────────────────────

model StressTestRun {
  id            Int      @id @default(autoincrement())
  startedAt     DateTime
  endedAt       DateTime
  modus         String
  technikerAnz  Int
  adminAnz      Int
  score         Int
  totalOps      Int
  fehler        Int
  avgResponseMs Int
  p95Ms         Int
  report        Json
  createdAt     DateTime @default(now())
}

// ── Nachrichten ──────────────────────────────────────────────────────────────
// Chat-Nachrichten nutzen logId = "chat:{anfrageId}" zur Zuordnung.

model Nachricht {
  id         Int                @id @default(autoincrement())
  betreff    String             @db.VarChar(255)
  inhalt     String             @db.Text
  vonKuerzel String
  typ        NachrichtTyp       @default(DIREKT)
  logId      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  empfaenger NachrichtEmpf[]
  antworten  NachrichtAntwort[]

  @@index([vonKuerzel])
  @@index([createdAt])
  @@index([logId])
}

model NachrichtEmpf {
  id          Int       @id @default(autoincrement())
  nachrichtId Int
  empfKuerzel String
  gelesen     Boolean   @default(false)
  gelesenAt   DateTime?
  nachricht   Nachricht @relation(fields: [nachrichtId], references: [id], onDelete: Cascade)

  @@unique([nachrichtId, empfKuerzel])
  @@index([empfKuerzel])
  @@index([nachrichtId])
}

model NachrichtAntwort {
  id          Int       @id @default(autoincrement())
  nachrichtId Int
  vonKuerzel  String
  inhalt      String    @db.Text
  createdAt   DateTime  @default(now())
  nachricht   Nachricht @relation(fields: [nachrichtId], references: [id], onDelete: Cascade)

  @@index([nachrichtId])
}

enum NachrichtTyp {
  DIREKT
  BROADCAST
  SYSTEM
}

// ── Externe Bestellungen (Bestell-Empfehlungs-System) ────────────────────────
// Manuelle Erfassung dessen, was Frank extern (z.B. Refurbished-Händler) für
// NICHT_VERFUEGBAR-Anfragen nachbestellt hat.
//
// Gruppierungs-Schlüssel: (modellName, teiltyp). Anfrage hat KEINEN modellId-FK,
// trägt das Modell nur als String (geraeteName). Daher wird hier exakt derselbe
// String gespeichert — so matchen Anfragen-Aggregat und Bestell-Summe 1:1 und
// die Offen-Zahl (Anfragen − Bestellt) ist exakt. `hersteller` ist denormalisiert
// (bei Erfassung aufgelöst) für die Anzeige.
model ExterneBestellung {
  id          Int      @id @default(autoincrement())
  modellName  String   @db.VarChar(500) // = Anfrage.geraeteName
  hersteller  String? // denormalisiert für Anzeige (best-effort aufgelöst)
  teiltyp     String // = Anfrage.teil
  anzahl      Int
  bestelltAm  DateTime // wann extern bestellt
  notiz       String?  @db.Text
  erstelltVon String // User.kuerzel
  user        User     @relation(fields: [erstelltVon], references: [kuerzel])
  erstelltAm  DateTime @default(now())

  @@index([modellName, teiltyp])
  @@index([erstelltVon])
}

// Nutzungs-Protokoll des Colli-Etiketten-Moduls (Nerd-Dashboard).
// Ein Eintrag pro Druckvorgang (Stapel oder Einzel) + Anzahl Etiketten — so kann
// das Dashboard wahlweise Druckvorgänge ODER Etiketten-Summe auswerten.
model ColliDruckLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  modus     String // 'colli' | 'text'
  anzahl    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ── Pickup — Sammel-/Scan-Hilfe (ersetzt Excel-Scan-Vergleichsliste) ──────────
// Lagernaut ist hier reine Scan-/Nachweis-Hilfe: KEINE Umbuchung, KEIN Bestands-
// einfluss (das passiert in ReForm). Aufträge + Positionen bleiben dauerhaft als
// Nachweis erhalten.
// Pickup-Auftragstyp: LogID-Suche (Geräte) vs. Colli-Suche (Stellplatz-Prüfung).
// Default LOGID hält bestehende Aufträge gültig (rein additiv).
enum PickupTyp {
  LOGID
  COLLI
}

model PickupAuftrag {
  id               Int              @id @default(autoincrement())
  name             String           @db.VarChar(200) // passend zu Zod .max(200) / input maxLength=200
  typ              PickupTyp        @default(LOGID)
  bemerkung        String?          @db.Text // optionaler Freitext (z.B. Verkäufer-Reservierungsnummer)
  status           String           @default("offen") // 'offen' | 'abgeschlossen'
  erstelltVon      Int
  ersteller        User             @relation("PickupErsteller", fields: [erstelltVon], references: [id])
  createdAt        DateTime         @default(now())
  abgeschlossenAm  DateTime?
  abgeschlossenVon Int?
  abschliesser     User?            @relation("PickupAbschliesser", fields: [abgeschlossenVon], references: [id])
  positionen       PickupPosition[]

  @@index([status])
  @@index([erstelltVon])
}

model PickupPosition {
  id          Int           @id @default(autoincrement())
  auftragId   Int
  auftrag     PickupAuftrag @relation(fields: [auftragId], references: [id], onDelete: Cascade)
  logId       String // normalisiert (reine Ziffern)
  colli       String?
  stellplatz  String?
  bezeichnung String?       @db.Text // AfB-Bezeichnungen bis 514+ Zeichen — wie GeraeteLookup/LogIdStand
  status      String        @default("OFFEN") // 'OFFEN' | 'GEFUNDEN'
  gefundenVon Int?
  finder      User?         @relation(fields: [gefundenVon], references: [id])
  gefundenAm  DateTime?

  @@index([auftragId, logId])
  @@index([logId])
}

// ── Lagerwagen-Zuordnung (Untercolli → Hauptcolli + Stellplatz) ───────────────
// Statischer Snapshot der mobilen Lagerwagen aus der ReForm-"Stellplatz"-Übersicht.
// Jeder Wagen hat genau EIN vorderes Hauptcolli und N Segment-(Unter-)Collis.
// Grundlage für den späteren Hauptcolli-Vorabscan im Pickup. Bei jedem Import
// VOLL ersetzt (die Datei ist der vollständige aktuelle Stand). Reine Zuordnung,
// KEIN Bestandseffekt.
model Lagerwagen {
  untercolli     String   @id // Segment-Colli, normalisiert (nurZiffern)
  hauptcolli     String // vorderes Colli des Wagens, normalisiert
  stellplatz     String?
  lagernummer    String?
  aktualisiertAm DateTime @updatedAt

  @@index([hauptcolli])
}

// ── Smartphone Refurbishment – Ersatzteile ────────────────────────────────────
// Eigenständiges Modul, unabhängig von den Notebook-Teilen (Artikel etc.).

enum SmartphoneTeilStatus {
  VERFUEGBAR
  RESERVIERT
  VERBAUT
  AUSGESONDERT
}

model SmartphoneArtikel {
  id          String              @id @default(cuid())
  aan         String              @unique
  bezeichnung String?
  marke       String?
  modell      String?
  teiletyp    String?
  qualitaet   String?
  farbe       String?
  bauteile    SmartphoneBauteil[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model SmartphoneColli {
  id         String              @id @default(cuid())
  nr         String              @unique
  typ        String?
  stellplatz String?
  bauteile   SmartphoneBauteil[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model SmartphoneBauteil {
  id           String               @id @default(cuid())
  logId        String               @unique
  artikelId    String
  artikel      SmartphoneArtikel    @relation(fields: [artikelId], references: [id])
  colliId      String?
  colli        SmartphoneColli?     @relation(fields: [colliId], references: [id])
  seriennummer String?
  bestellungPo String?
  status       SmartphoneTeilStatus @default(VERFUEGBAR)
  anfrageId    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([artikelId, status])
  @@index([colliId])
}

// Speicherbare Vorlagen fürs Label-Tool (geteilt & dauerhaft). Nur für die
// Formate "schrank" und "text"; Colli bleibt ohne Vorlagen.
model LabelVorlage {
  id           String   @id @default(cuid())
  typ          String // "schrank" | "text"
  name         String
  html         String   @db.Text // WYSIWYG-Inhalt (kann lang sein!)
  orientierung String? // nur schrank: "quer" | "hoch"
  qrAktiv      Boolean  @default(false) // nur schrank
  stellplatz   String? // nur schrank
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([typ, name]) // Name eindeutig je Typ
}

// ── Geräte-Reise (LogID-Tracking) ────────────────────────────────────────────
// Reine Auswertung von ReForm-LogID-Snapshots. KEIN Bestandseffekt, kein
// Eingriff in Ersatzteil-/Pickup-Logik. Additiv, eigenständige Tabellen.

// Aktueller Stand je LogID — 1 Zeile pro Gerät, je Import per Upsert aktualisiert.
model LogIdStand {
  logId String @id

  hersteller   String?
  bezeichnung  String? @db.Text
  geraeteart   String?
  unterart     String?
  seriennummer String?

  stellplatz       String?
  stellplatzStatus String?
  lager            String?
  lagernummer      String?
  filiale          String?

  colli           String?
  vorherigesColli String?
  statusColli     String?

  verbleib        String?
  inVerbleibSeit  DateTime?
  inVerbleibDurch String?

  aufLagerGebuchtAm DateTime?
  verweildauerTage  Int?
  letzteAenderungAm DateTime?

  refurbished    Boolean   @default(false)
  refurbishDatum DateTime?

  grading          String?
  initialesGrading String?
  aktuellerZustand String?

  blockiert    Boolean   @default(false)
  begruendung  String?   @db.Text
  blockiertVon String?
  blockiertAm  DateTime?

  salestatus String?

  // Einkaufswert (CSV-Spalte "EK"), deutsches Zahlenformat → Decimal(12,2).
  ek Decimal? @db.Decimal(12, 2)

  erstmalsGesehen DateTime
  zuletztGesehen  DateTime
  zuletztImportId Int

  // Abgang: LogID fehlt im neuesten Voll-Snapshot → hat das System verlassen.
  ausgeschieden   Boolean   @default(false)
  ausgeschiedenAm DateTime?

  @@index([verbleib])
  @@index([lager])
  @@index([lagernummer])
  @@index([stellplatz])
  @@index([geraeteart])
  @@index([verweildauerTage])
  @@index([ausgeschieden])
}

// Import-Art: regulärer Lagerfuchs-Voll-Snapshot vs. Fehlteile-Liste.
enum ImportTyp {
  LAGERFUCHS
  FEHLTEILE
}

// Ein Import-Lauf (eine hochgeladene Datei).
model LogIdImport {
  id                  Int       @id @default(autoincrement())
  dateiname           String
  importiertAm        DateTime  @default(now())
  status              String    @default("läuft") // läuft | fertig | fehler
  typ                 ImportTyp @default(LAGERFUCHS) // automatisch erkannt
  anzahlZeilen        Int       @default(0)
  anzahlNeu           Int       @default(0)
  anzahlAktualisiert  Int       @default(0)
  anzahlBewegungen    Int       @default(0)
  anzahlAusgeschieden Int       @default(0) // im Snapshot fehlende LogIDs
  verarbeitet         Int       @default(0) // Fortschritt
  fehlerText          String?   @db.Text
  erstelltVon         Int?
}

// Fehlteile (Verbleib = "Fehlteile") — eigene Tabelle, KEINE Diff-/Bewegungs-
// Logik. Je LogID ein aktueller Stand (Upsert). Reine Auswertung.
model FehlteilStand {
  logId             String    @id
  seriennummer      String?
  hersteller        String?
  bezeichnung       String?   @db.Text
  geraeteart        String?
  unterart          String?
  aktuellerZustand  String?
  grading           String?
  sortiment         String?
  aan               String?
  inVerbleibSeit    DateTime?
  inVerbleibDurch   String?
  aufLagerGebuchtAm DateTime?
  verweildauerTage  Int?
  lager             String?
  zuletztImportId   Int?
  zuletztGesehen    DateTime?

  @@index([hersteller])
  @@index([geraeteart])
  @@index([sortiment])
  @@index([inVerbleibSeit])
}

// Änderungs-Ereignis je LogID-Feld. Wird ab dem 2. Import befüllt
// (beim 1. Import sind alle LogIds neu → keine Bewegung).
model LogIdBewegung {
  id         Int      @id @default(autoincrement())
  logId      String
  feld       String
  vonWert    String?
  nachWert   String?
  zeitpunkt  DateTime
  bearbeiter String?
  importId   Int
  createdAt  DateTime @default(now())

  @@index([logId, zeitpunkt])
  @@index([feld])
  @@index([importId])
}

// Impact-/Nachhaltigkeits-Kennzahlen — editierbare Pauschal-Annahmen (Singleton,
// immer id=1). Je wiederverwendetem Ersatzteil eingespartes CO2 (kg) und Gewicht
// (kg, = vermiedener E-Schrott). Bewusst grobe, anpassbare Schätzwerte; die echte
// Zahl setzt AfB selbst. Wird auf /admin/impact ausgewertet.
model ImpactEinstellung {
  id               Int      @id @default(1)
  co2ProTeilKg     Decimal  @default(0) @db.Decimal(10, 3)
  gewichtProTeilKg Decimal  @default(0) @db.Decimal(10, 3)
  aktualisiertAm   DateTime @updatedAt
}

// ── Verbrauchsmaterial / Kartonage ────────────────────────────────────────────
// Bestandsführung für Verbrauchsmaterial (heute in Excel). Stammdaten + aktueller
// Bestand; Code dient später als QR-/Etiketten-Code. Reine Materialwirtschaft,
// getrennt vom Geräte-/Teile-Lager (KEIN Bestandseffekt dort).
model VerbrauchsArtikel {
  id               Int                     @id @default(autoincrement())
  code             String                  @unique // QR-/Etiketten-Code, z.B. "VM-0001"
  name             String                  @db.VarChar(255)
  merkmale         String?                 @db.VarChar(255)
  kategorie        String?                 @db.VarChar(100)
  mindestbestand   Int                     @default(0)
  aktuellerBestand Int                     @default(0)
  aan              String?                 @db.VarChar(100)
  gebindegroesse   Int?
  standort         String?                 @db.VarChar(191)
  bemerkung        String?                 @db.Text
  aktiv            Boolean                 @default(true)
  // ── Von der wöchentlichen Zählung ausgenommen ─────────────────────────────
  // NICHT dasselbe wie `aktiv`. `aktiv = false` ist der Soft-Delete: der Artikel
  // verschwindet aus Liste, Nachbestell-Vorschlag und Kennzahlen. Hier geht es
  // um Positionen, die weiterleben und weiter bestellt werden, bei denen das
  // wöchentliche Nachzählen aber keinen Sinn ergibt — Dauerbestände, extern
  // geführte Positionen, Dinge die stückweise nicht zählbar sind.
  //
  // Wirkt NUR auf den Wochen-Zählweg (`dieseWoche`: Fortschritt X/Y und die
  // Liste „noch offen"). Wer den QR-Code trotzdem scannt, darf zählen — die
  // Zählung wird dann als „ausgenommen" gekennzeichnet und zählt nicht in den
  // Wochenfortschritt, sonst wäre X größer als Y.
  zaehlpflichtig   Boolean                 @default(true)
  erstelltAm       DateTime                @default(now())
  aktualisiertAm   DateTime                @updatedAt
  zaehlungen       VerbrauchsZaehlung[]
  bild             VerbrauchsArtikelBild? // ALT (1:1) — nur noch für Backfill, danach entfernbar
  fotos            VerbrauchsArtikelFoto[]

  @@index([kategorie])
  @@index([aktiv])
}

// Foto-Galerie je Artikel (0..n). `position` bestimmt die Reihenfolge; das Foto
// mit der KLEINSTEN position ist das **Titelbild** (Liste-Thumbnail, A5-Schild,
// Info-Vorschau). Eigene Tabelle, damit die Listen-Query NIE die Bytes mitlädt.
// In der DB gespeichert (überlebt Container-Rebuild — kein flüchtiges
// public/uploads). Verkleinert vom Client (~1600px, JPEG). Ausgeliefert über
// GET /api/verbrauchsmaterial/bild/[artikelId] (Titelbild) bzw.
// GET /api/verbrauchsmaterial/foto/[fotoId] (einzelnes Galerie-Foto).
model VerbrauchsArtikelFoto {
  id             Int               @id @default(autoincrement())
  artikelId      Int
  artikel        VerbrauchsArtikel @relation(fields: [artikelId], references: [id], onDelete: Cascade)
  position       Int               @default(0) // 0 = Titelbild; aufsteigend sortiert
  mimeType       String            @db.VarChar(100)
  daten          Bytes             @db.MediumBlob
  erstelltAm     DateTime          @default(now())
  aktualisiertAm DateTime          @updatedAt

  @@index([artikelId])
}

// ALT: Foto je Artikel (1:1). Wird durch VerbrauchsArtikelFoto (Galerie) abgelöst.
// Bleibt nur, bis der Backfill (prisma/scripts/migrate-vm-fotos.ts) die Bilder in
// die neue Tabelle übernommen hat — danach kann Modell + Relation `bild` weg
// (db push droppt dann die Tabelle).
model VerbrauchsArtikelBild {
  artikelId      Int               @id
  artikel        VerbrauchsArtikel @relation(fields: [artikelId], references: [id], onDelete: Cascade)
  mimeType       String            @db.VarChar(100)
  daten          Bytes             @db.MediumBlob
  erstelltAm     DateTime          @default(now())
  aktualisiertAm DateTime          @updatedAt
}

// Zählungs-/Bestandshistorie (Grundlage für spätere Verbrauchsauswertung S4).
model VerbrauchsZaehlung {
  id         Int               @id @default(autoincrement())
  artikelId  Int
  artikel    VerbrauchsArtikel @relation(fields: [artikelId], references: [id], onDelete: Cascade)
  datum      DateTime          @default(now())
  vorher     Int
  bestand    Int
  verbrauch  Int // max(0, vorher - bestand)
  benutzer   String?           @db.VarChar(100)
  bemerkung  String?           @db.VarChar(255)
  erstelltAm DateTime          @default(now())

  @@index([artikelId])
  @@index([datum])
}

// ── Mobil-Ersatzteile (Smartphone/Tablet-Teile mit LogID) ────────────────────
// EIGENES Modul, getrennt vom Laptop-Artikel-/Modell-System. Alle Infos werden
// aus der Freitext-Spalte "Bezeichnung" abgeleitet (siehe src/lib/mobil/parser).
// Schema NUR definiert — NOCH NICHT gepusht (kein db push).
// Status-Logik: ERKANNT = sicher zugeordnet, REVIEW = nicht eindeutig (Parser
// rät nicht), MANUELL = vom Mensch zugeordnet (wird i. d. R. als Alias gelernt).

enum MobilZuordnungStatus {
  ERKANNT
  REVIEW
  MANUELL
}

model MobilModell {
  id         Int      @id @default(autoincrement())
  hersteller String // z. B. "Apple"
  modell     String // z. B. "iPhone 14"
  aktiv      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teile          MobilTeil[] // Teile mit diesem Modell als PRIMÄR-Modell
  teilLinks      MobilTeilModell[] // alle kompatiblen Teile (inkl. Mehrfach-Modell)
  aliase         MobilAlias[]
  mindestbestand MobilMindestbestand[]
  anfragen       MobilAnfrage[]

  @@unique([hersteller, modell])
}

model MobilTeiltyp {
  id        Int      @id @default(autoincrement())
  name      String   @unique // z. B. "Akku","Display","Kameraglas","Backcover","Middle Frame","SIM-Tray"
  createdAt DateTime @default(now())

  teile          MobilTeil[]
  aliase         MobilAlias[]
  mindestbestand MobilMindestbestand[]
}

// Eine Zeile = EINE physische LogID = EIN Stück. NIE dupliziert (logId @unique) —
// damit ist die Mengen-Zählung immer korrekt: physischer Bestand = COUNT(MobilTeil).
// Ein Teil kann zu MEHREREN Modellen kompatibel sein ("12 / 12 Pro") → die volle
// Kompatibilitätsliste steht in MobilTeilModell, NICHT durch Vervielfachung der
// MobilTeil-Zeile. modellId = primäres/repräsentatives Modell (Schnellzugriff/UI;
// null bei REVIEW). teiltypId ist immer einwertig (ein Teil hat genau einen Typ).
model MobilTeil {
  id                   Int                  @id @default(autoincrement())
  logId                String               @unique
  originalBezeichnung  String               @db.Text
  colli                String?
  stellplatz           String?
  ek                   Decimal?             @db.Decimal(10, 2)
  aan                  String? // Artikelnummer (CSV "AAN")
  lieferant            String? // CSV "Lieferant"
  farbe                String? // aus Bezeichnung erkannt (DE-normalisiert)
  status               String?
  modellId             Int? // primäres Modell (null = REVIEW/unbekannt)
  modell               MobilModell?         @relation(fields: [modellId], references: [id])
  modelle              MobilTeilModell[] // ALLE kompatiblen Modelle (inkl. Primär)
  teiltypId            Int?
  teiltyp              MobilTeiltyp?        @relation(fields: [teiltypId], references: [id])
  zuordnungStatus      MobilZuordnungStatus @default(REVIEW)
  // Kostenstelle/Bereich: trennt z. B. die regulären Mobil-Teile ("STANDARD") von
  // "DIGITAL_EDUCATION" (eigene Kostenstelle, eigener Reiter). Eigener Import-Scope:
  // ein DE-Import berührt NUR DE-Teile (Abgangs-Erkennung filtert nach bereich).
  bereich              String               @default("STANDARD") @db.VarChar(32)
  importiertAm         DateTime             @default(now())
  // Abgangs-Erkennung (Lagerfuchs-Muster): ein Teil, das im aktuellen Voll-Export
  // fehlt, gilt als ausgeschieden (ausgeliefert) und zählt NICHT mehr zum Bestand,
  // bleibt aber für Statistik/Verlauf erhalten. zuletztGesehenImport = Zeitstempel
  // des letzten Imports, in dem die LogID vorkam (Marker für die Abgangs-Erkennung).
  ausgeschieden        Boolean              @default(false)
  ausgeschiedenAm      DateTime?
  zuletztGesehenImport DateTime?

  @@index([modellId])
  @@index([teiltypId])
  @@index([zuordnungStatus])
  @@index([ausgeschieden])
  @@index([bereich])
  @@index([colli])
  @@index([zuletztGesehenImport])
}

// Kompatibilität Teil ↔ Modell (n:m). Ein Eintrag je erkanntem kompatiblen Modell.
// Zählt NICHT als physischer Bestand (das tut MobilTeil) — nur für „welche Teile
// passen zu Modell X". Bei Re-Import werden die Links eines Teils neu aufgebaut
// (außer das Teil ist MANUELL zugeordnet).
model MobilTeilModell {
  id       Int         @id @default(autoincrement())
  teilId   Int
  teil     MobilTeil   @relation(fields: [teilId], references: [id], onDelete: Cascade)
  modellId Int
  modell   MobilModell @relation(fields: [modellId], references: [id])

  @@unique([teilId, modellId])
  @@index([modellId])
}

// Gelernte Zuordnung: derselbe normalisierte Wortlaut wird nie zweimal manuell
// zugeordnet. Wird vom Parser (zuordnen()) vor dem Regelwerk geprüft.
model MobilAlias {
  id              Int          @id @default(autoincrement())
  bezeichnungNorm String       @unique // normalisierter Wortlaut (lower, getrimmt)
  modellId        Int
  modell          MobilModell  @relation(fields: [modellId], references: [id])
  teiltypId       Int
  teiltyp         MobilTeiltyp @relation(fields: [teiltypId], references: [id])
  createdAt       DateTime     @default(now())

  @@index([modellId])
  @@index([teiltypId])
}

// Soll-Mengen je Modell+Teiltyp (für späteren Schritt 4 — Schema gleich vollständig).
// Mindestbestand je Modell+Teiltyp+Bereich (getrennte Soll-Mengen je Kostenstelle).
// WICHTIG (MySQL): Der eigene `@@index([modellId])` ist NÖTIG, damit der 2-spaltige
// Unique gegen den 3-spaltigen getauscht werden kann — sonst blockiert der
// modellId-Fremdschlüssel das Droppen des alten Unique (er bräuchte ihn als
// Backing-Index). Mit dem dedizierten Index hat der FK sein eigenes Backing.
model MobilMindestbestand {
  id        Int          @id @default(autoincrement())
  modellId  Int
  modell    MobilModell  @relation(fields: [modellId], references: [id])
  teiltypId Int
  teiltyp   MobilTeiltyp @relation(fields: [teiltypId], references: [id])
  sollMenge Int
  bereich   String       @default("STANDARD") @db.VarChar(32)

  @@unique([modellId, teiltypId, bereich])
  @@index([modellId])
}

// ── Kategorie-Preise (Laptop-Ersatzteile) ───────────────────────────────────
// Laptop-Artikel haben selbst KEINEN Preis (aus Altgeräten geerntet). Hier wird
// ein Stückpreis je Artikel-Kategorie (Akku, Displaymodul, Tastatur, …) gepflegt.
// Grundlage für die Auswertung „Wert ausgegeben über Anfragen" (menge × preis,
// gejoint Buchung→Artikel→kategorie). Kein FK auf Artikel — Kategorie ist nur ein
// String-Feld auf Artikel; Verknüpfung erfolgt über den Kategorie-Namen.
model KategoriePreis {
  id             Int      @id @default(autoincrement())
  kategorie      String   @unique @db.VarChar(191)
  preis          Decimal  @db.Decimal(10, 2)
  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt
}

// ── Mobil-Anfragen (Techniker fragt ein mobiles Ersatzteil an) ───────────────
enum MobilAnfrageStatus {
  NEU
  BEDARF
  IN_BEARBEITUNG
  ABGESCHLOSSEN
  STORNIERT
}

// Ersatzteil-Anfrage eines Technikers für ein MOBILES Gerät (Smartphone/Tablet).
// Eigenes System, getrennt von der Laptop-`Anfrage` (kein Artikel-Bezug, damit die
// Laptop-Statistik/Bestell-Empfehlung NICHT mit Mobil-Zeilen verschmutzt). Der
// Techniker wählt Bereich → Modell → Teiltyp; Status NEU (Bestand>0) bzw. BEDARF (=0)
// wird beim Anlegen aus dem aktuellen Mobil-Bestand abgeleitet. Recht: ANFRAGE_MOBIL_CREATE.
model MobilAnfrage {
  id            Int                @id @default(autoincrement())
  datum         DateTime           @default(now())
  techniker     String // Kürzel des Anfragenden
  bereich       String             @default("STANDARD") @db.VarChar(32)
  modellId      Int
  modell        MobilModell        @relation(fields: [modellId], references: [id])
  teiltyp       String // Teiltyp-Name (MOBIL_TEILTYPEN)
  farbe         String?            @db.VarChar(32) // gewünschte Farbe (bei Farbvarianten, z.B. Backcover); null = egal
  menge         Int                @default(1)
  kommentar     String?            @db.Text
  // Sendungs-/Warenkorb-Gruppe: alle Teile, die der Techniker in EINER Sendung
  // abschickt, teilen dieselbe gruppenNr. Spätere Sendung = neue gruppenNr = neue Anfrage.
  gruppenNr     String?            @db.VarChar(64)
  status        MobilAnfrageStatus @default(NEU)
  bearbeitetVon String?
  erledigtLogId String? // beim Erledigen ausgegebene Teil-LogID (Etappe B)
  // Manuell „komplett" markiert (Tap-Fallback ohne Scan). Der eigentliche Pick-
  // Fortschritt kommt aus den erfassten LogIDs (picks): komplett = gefunden ODER
  // picks.count >= menge.
  gefunden      Boolean            @default(false)
  gefundenAm    DateTime?
  picks         MobilAnfragePick[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([techniker])
  @@index([status])
  @@index([modellId])
  @@index([bereich])
  @@index([gruppenNr])
}

// Beim Picken (Handheld) gescannte LogIDs je Mobil-Anfrage. Ein Pick = ein
// physisches Teil gefunden. Beim Umbuchen werden GENAU diese LogIDs ausgebucht.
model MobilAnfragePick {
  id          Int          @id @default(autoincrement())
  anfrageId   Int
  anfrage     MobilAnfrage @relation(fields: [anfrageId], references: [id], onDelete: Cascade)
  logId       String       @db.VarChar(191)
  gescanntVon String?      @db.VarChar(100)
  gescanntAm  DateTime     @default(now())

  @@unique([anfrageId, logId]) // dieselbe LogID nicht doppelt an derselben Anfrage
  @@index([anfrageId])
  @@index([logId])
}

// ── Bestellanfragen Eigenbedarf ──────────────────────────────────────────────
// Löst die wöchentliche Excel-Liste ab: Was gebraucht wird, wird hier erfasst
// und montags gesammelt an den Standortleiter geschickt, der sie an den Einkauf
// weitergibt.
//
// Bewusst NICHT mit `Artikel` verknüpft: Hier steht überwiegend Material, das
// Lagernaut gar nicht führt (Handschuhe, Kopierpapier, Bürostühle). Eine
// Freitext-Beschreibung mit Link ist genau richtig, ein Fremdschlüssel wäre
// eine Fessel ohne Nutzen.
model Bestellanfrage {
  id             Int                  @id @default(autoincrement())
  anzahl         Int
  hersteller     String?              @db.VarChar(191)
  beschreibung   String               @db.Text
  link           String?              @db.Text
  verwendungsort String?              @db.VarChar(191)
  status         BestellanfrageStatus @default(OFFEN)
  angefordertVon String               @db.VarChar(50)
  angefordertAm  DateTime             @default(now())
  // Der Montag, an dem die Position tatsächlich rausgeschickt wurde.
  versendetAm    DateTime?
  geliefertAm    DateTime?
  notiz          String?              @db.VarChar(500)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status])
  @@index([versendetAm])
}

enum BestellanfrageStatus {
  OFFEN // erfasst, geht bei der nächsten Bestellung raus
  BESTELLT // an Standortleitung/Einkauf gegangen
  GELIEFERT // angekommen
  // Von der Standortleitung oder vom Einkauf abgelehnt. Bewusst getrennt von
  // STORNIERT: Dort haben WIR die Position zurückgezogen, hier wurde sie uns
  // abgelehnt. Für spätere Rückfragen ist der Unterschied wesentlich.
  NICHT_GENEHMIGT
  STORNIERT // von uns zurückgezogen
}

// ── Versand: „Gleiches Gerät finden" ─────────────────────────────────
//
// Eigener Schnappschuss aus einem ReForm-CSV-Export.
//
// ⚠️ BEWUSST getrennt von LogIdStand (Lagerfuchs). Dieser Bereich importiert
// seine Daten selbst; ein Import hier darf die Abgangs-Erkennung des Lagerfuchs
// nicht auslösen und umgekehrt. Jeder Import ERSETZT den Bestand vollständig —
// die hochgeladene Datei ist der aktuelle Stand, es wird keine Historie geführt.
//
// logIdClean hält die punktfreie Fassung: Der Handscanner liefert „212965142",
// gespeichert wird „212.965.142". Ohne diese Spalte findet ein Scan nichts.
model VersandGeraet {
  logId        String   @id @db.VarChar(32)
  logIdClean   String   @db.VarChar(32)
  hersteller   String?  @db.VarChar(64)
  bezeichnung  String?  @db.VarChar(255)
  geraeteart   String?  @db.VarChar(64)
  grading      String?  @db.VarChar(8)
  stellplatz   String?  @db.VarChar(64)
  colli        String?  @db.VarChar(32)
  lager        String?  @db.VarChar(64)
  verbleib     String?  @db.VarChar(64)
  importiertAm DateTime

  @@index([logIdClean])
  @@index([bezeichnung, grading])
  @@index([stellplatz])
}

// ── Entsorgung: Schrottabholung und Batterietransport ───────────────────
//
// Derselbe Vorgang in zwei Ausführungen: Behälter erfassen, Gewichte
// summieren, Tabelle an den Entsorger schicken. Ein Auftrag ist eine Abholung,
// jede Position ein Behälter (Colli bzw. Fass).
//
// ⚠️ Der Unterschied steckt allein im Feld `bereich`. Beschriftung und
// Kapazitätsregel stehen in src/lib/entsorgung/bereiche.ts — NICHT hier
// nachbilden, sonst driften Datenbank und Oberfläche auseinander.

enum EntsorgungBereich {
  SCHROTT
  BATTERIE
}

enum EntsorgungStatus {
  OFFEN
  VERSENDET
  ERLEDIGT
}

/// Stammdaten der Abfallarten.
///
/// ⚠️ Eine Schlüsselnummer kann MEHRERE Abfallarten tragen
/// (16 02 13 = Elektronikschrott gemischt UND Laptop ohne Akku). Die Richtung
/// ist deshalb nur Abfallart → Schlüssel, niemals zurück. Aus dem Schlüssel
/// allein lässt sich nicht sagen, was im Behälter liegt.
model EntsorgungAbfallart {
  id          Int               @id @default(autoincrement())
  bereich     EntsorgungBereich @default(SCHROTT)
  /// Voller Name, wie im Abfallverzeichnis — eindeutig.
  bezeichnung String            @unique @db.VarChar(191)
  /// Kurzform für die Auftragstabelle ("ext. Netzt."). Muss die Arten
  /// UNTERSCHEIDBAR halten: "Kabel" allein wäre zweideutig.
  kurzform    String            @db.VarChar(40)
  /// Abfallschlüssel ohne Leerzeichen ("160216").
  schluessel  String            @db.VarChar(16)
  /// Leergewicht des Behälters in kg. Vorschlag beim Erfassen: Netto = Brutto
  /// minus Tara. Bei den Schrott-Altdaten durchgängig 85 kg (Gitterbox).
  taraKg      Int?
  aktiv       Boolean           @default(true)
  sortierung  Int               @default(0)
  erstelltAm  DateTime          @default(now())

  positionen EntsorgungPosition[]

  @@index([bereich, aktiv, sortierung])
}

model EntsorgungAuftrag {
  id             Int               @id @default(autoincrement())
  bereich        EntsorgungBereich @default(SCHROTT)
  bezeichnung    String            @db.VarChar(191)
  datum          DateTime
  status         EntsorgungStatus  @default(OFFEN)
  notiz          String?           @db.Text
  erstelltVon    String            @db.VarChar(64)
  erstelltAm     DateTime          @default(now())
  aktualisiertAm DateTime          @updatedAt

  positionen EntsorgungPosition[]

  @@index([bereich, status])
  @@index([datum])
}

model EntsorgungPosition {
  id        Int               @id @default(autoincrement())
  auftragId Int
  auftrag   EntsorgungAuftrag @relation(fields: [auftragId], references: [id], onDelete: Cascade)

  /// Colli- bzw. Fassnummer. Nur Ziffern, Punkte werden beim Erfassen
  /// entfernt ("3.202.971" → "3202971").
  nummer      String @db.VarChar(32)
  abfalllager String @db.VarChar(64)

  abfallartId Int
  abfallart   EntsorgungAbfallart @relation(fields: [abfallartId], references: [id])

  /// ⚠️ Schlüssel und Kurzform werden beim Erfassen KOPIERT, nicht bei jeder
  /// Anzeige nachgeschlagen. Wird eine Abfallart später in den Stammdaten
  /// geändert, darf sich ein bereits verschickter Auftrag nicht rückwirkend
  /// ändern — er liegt beim Entsorger als Nachweis.
  schluessel String @db.VarChar(16)
  kurzform   String @db.VarChar(40)

  bruttoKg   Int
  nettoKg    Int
  versandart String @db.VarChar(32)

  /// Nur beim Batterietransport: UN 3090 (Lithium-Metall) oder UN 3480
  /// (Lithium-Ionen), wie es auf dem Fass steht. Das ist die
  /// Transportkennzeichnung nach ADR und etwas anderes als der
  /// Abfallschlüssel — beide gehören auf die Papiere.
  unNummer String? @db.VarChar(8)

  position   Int      @default(0)
  erfasstVon String   @db.VarChar(64)
  erfasstAm  DateTime @default(now())

  @@index([auftragId, position])
  @@index([nummer])
}
